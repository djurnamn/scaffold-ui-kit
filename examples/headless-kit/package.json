{
  "name": "headless-kit-example",
  "version": "0.1.0",
  "private": true,
  "description": "An unstyled, accessibility-first primitives kit for React, Vue and Svelte, built with scaffold-ui-kit.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./react": "./dist/react/index.ts",
    "./react/*": "./dist/react/*.tsx",
    "./vue": "./dist/vue/index.ts",
    "./vue/*": "./dist/vue/*",
    "./svelte": "./dist/svelte/index.ts",
    "./svelte/*": "./dist/svelte/*"
  },
  "bin": {
    "headless-kit-example": "./bin/add.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/components",
    "README.md"
  ],
  "scripts": {
    "build": "scaffold-ui-kit build",
    "typecheck": "tsc && npm run typecheck:react && npm run typecheck:vue && npm run typecheck:svelte",
    "typecheck:react": "tsc --project tsconfig.react.json",
    "typecheck:vue": "vue-tsc --project tsconfig.vue.json",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "check": "scaffold-ui-kit-preview check --strict",
    "preview": "scaffold-ui-kit-preview dev",
    "preview:build": "scaffold-ui-kit-preview build",
    "test": "vitest run",
    "test:browser": "npm run preview:build && playwright test",
    "typecheck:consumer": "tsc --project tsconfig.consumer-react.json && vue-tsc --project tsconfig.consumer-vue.json && node tests/typecheck-svelte.mjs"
  },
  "keywords": [
    "ui-kit",
    "component-library",
    "headless",
    "accessibility",
    "react",
    "vue",
    "svelte"
  ],
  "dependencies": {
    "@scaffold-ui-kit/add": "^2.3.0",
    "@scaffold-ui-kit/helpers": "^2.3.0",
    "@zag-js/dialog": "^1.44.0",
    "@zag-js/select": "^1.44.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@js-template-engine/types": "^2.3.0",
    "@playwright/test": "^1.56.0",
    "@scaffold-ui-kit/preview": "^2.3.0",
    "@scaffold-ui-kit/testing": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@zag-js/react": "^1.44.0",
    "@zag-js/svelte": "^1.44.0",
    "@zag-js/vue": "^1.44.0",
    "charcell": "^0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "scaffold-ui-kit": "^2.3.0",
    "svelte": "^5.29.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@zag-js/react": "^1.44.0",
    "@zag-js/svelte": "^1.44.0",
    "@zag-js/vue": "^1.44.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svelte": "^5.29.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "@zag-js/react": {
      "optional": true
    },
    "@zag-js/svelte": {
      "optional": true
    },
    "@zag-js/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
