{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scaffold-ui-kit.ts",
    "src/**/*",
    "preview/**/*.ts",
    "preview/**/*.tsx"
  ]
}
