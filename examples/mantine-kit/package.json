{
  "name": "mantine-style-kit-example",
  "version": "0.1.0",
  "private": true,
  "description": "An example Mantine-style UI kit built with scaffold-ui-kit for React, Vue, Svelte and HTML",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./react": "./dist/react/index.ts",
    "./react/unlinked": "./dist/react/unlinked/index.ts",
    "./react/unlinked/*": "./dist/react/*.tsx",
    "./react/*.css": "./dist/react/*.css",
    "./react/*": "./dist/react/linked/*.ts",
    "./vue": "./dist/vue/index.ts",
    "./vue/unlinked": "./dist/vue/unlinked/index.ts",
    "./vue/unlinked/*": "./dist/vue/*",
    "./vue/*.css": "./dist/vue/*.css",
    "./vue/*": "./dist/vue/linked/*.ts",
    "./svelte": "./dist/svelte/index.ts",
    "./svelte/unlinked": "./dist/svelte/unlinked/index.ts",
    "./svelte/unlinked/*": "./dist/svelte/*",
    "./svelte/*.css": "./dist/svelte/*.css",
    "./svelte/*": "./dist/svelte/linked/*.ts",
    "./themes/*": "./themes/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "mantine-style-kit-example": "./bin/add.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/components",
    "src/template-helpers",
    "themes",
    "README.md",
    "LICENSE-NOTICES.md"
  ],
  "scripts": {
    "build": "scaffold-ui-kit build",
    "typecheck": "tsc && npm run typecheck:react && npm run typecheck:vue && npm run typecheck:svelte",
    "typecheck:react": "tsc --project tsconfig.react.json",
    "typecheck:vue": "vue-tsc --project tsconfig.vue.json",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "check": "scaffold-ui-kit-preview check --strict",
    "preview": "scaffold-ui-kit-preview dev",
    "preview:build": "scaffold-ui-kit-preview build",
    "typecheck:consumer": "tsc --project tsconfig.consumer.react.json && vue-tsc --project tsconfig.consumer.vue.json && node tests/check-svelte.mjs",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test"
  },
  "keywords": [
    "ui-kit",
    "component-library",
    "react",
    "vue",
    "svelte",
    "html"
  ],
  "dependencies": {
    "@scaffold-ui-kit/add": "^2.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@js-template-engine/types": "^2.3.0",
    "@playwright/test": "^1.59.0",
    "@scaffold-ui-kit/preview": "^2.3.0",
    "@scaffold-ui-kit/testing": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@zag-js/react": "^1.44.0",
    "charcell": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scaffold-ui-kit": "^2.3.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "svelte": "^5.20.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
